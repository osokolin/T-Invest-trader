# ============================================================
# T-Invest Trader -- Runtime Configuration
# Copy to .env and fill in real values before deployment.
# ============================================================

# -- Environment --
TINVEST_ENVIRONMENT=sandbox

# -- Broker --
TINVEST_TOKEN=your-tbank-api-token-here
TINVEST_ACCOUNT_ID=your-account-id-here
TINVEST_SANDBOX=true

# -- Database --
# DSN must match docker-compose postgres service credentials.
TINVEST_POSTGRES_DSN=postgresql://tinvest:tinvest_local@postgres:5432/tinvest
POSTGRES_PASSWORD=tinvest_local

# -- Grafana --
# Change these before exposing Grafana publicly.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -- Instruments --
TINVEST_TRACKED_INSTRUMENTS=
TINVEST_ENABLED_INSTRUMENTS=

# -- Sentiment --
TINVEST_SENTIMENT_ENABLED=false
TINVEST_SENTIMENT_CHANNELS=
TINVEST_SENTIMENT_TRACKED_TICKERS=
TINVEST_SENTIMENT_MODEL_NAME=stub
TINVEST_SENTIMENT_SOURCE_BACKEND=stub

# -- Observation --
TINVEST_OBSERVATION_ENABLED=false
TINVEST_OBSERVATION_WINDOWS=5m,15m,1h
TINVEST_OBSERVATION_PERSIST_DERIVED=true
TINVEST_OBSERVATION_TRACKED_TICKERS=

# -- Signal delivery severity --
TINVEST_SIGNAL_HIGH_CONFIDENCE_THRESHOLD=0.6
TINVEST_SIGNAL_HIGH_EV_THRESHOLD=0.00015
TINVEST_SIGNAL_MIN_RESOLVED_FOR_STATS=10
TINVEST_SIGNAL_MIN_WIN_RATE_FOR_STRONG_EV=0.35

# -- Shadow paper portfolio --
# Persists virtual positions from new delivered signals only. Never submits orders.
TINVEST_PAPER_PORTFOLIO_ENABLED=false
TINVEST_PAPER_PORTFOLIO_NAME=shadow-v1
TINVEST_PAPER_PORTFOLIO_INITIAL_CASH=1000000
TINVEST_PAPER_PORTFOLIO_POSITION_FRACTION=0.10
TINVEST_PAPER_PORTFOLIO_MAX_OPEN_POSITIONS=5
TINVEST_PAPER_PORTFOLIO_COMMISSION_RATE=0.0005
TINVEST_PAPER_PORTFOLIO_SLIPPAGE_RATE=0.0005
TINVEST_PAPER_PORTFOLIO_POLL_INTERVAL_SECONDS=60
TINVEST_PAPER_PORTFOLIO_ENTRY_STAGES=delivered
TINVEST_BACKGROUND_RUN_PAPER_PORTFOLIO=true

# -- Market activity monitor --
# Observes T-Bank minute candles and persists activity spikes. Never trades.
TINVEST_MARKET_ACTIVITY_ENABLED=false
TINVEST_MARKET_ACTIVITY_POLL_INTERVAL_SECONDS=60
TINVEST_MARKET_ACTIVITY_CANDLE_INTERVAL=CANDLE_INTERVAL_1_MIN
TINVEST_MARKET_ACTIVITY_LOOKBACK_MINUTES=60
TINVEST_MARKET_ACTIVITY_BASELINE_CANDLES=20
TINVEST_MARKET_ACTIVITY_MIN_VOLUME=1
TINVEST_MARKET_ACTIVITY_VOLUME_SPIKE_MULTIPLIER=3.0
TINVEST_MARKET_ACTIVITY_PRICE_CHANGE_SPIKE_PCT=0.01
TINVEST_BACKGROUND_RUN_MARKET_ACTIVITY=true

# -- Logging --
TINVEST_LOG_LEVEL=INFO
TINVEST_LOG_JSON=true
